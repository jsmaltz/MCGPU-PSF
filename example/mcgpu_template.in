 
# >>>> INPUT FILE FOR MC-GPU v1.5 VICTRE-DBT >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>
 
#[SECTION SIMULATION CONFIG v.2009-05-12]
dataset.ncase                   # TOTAL NUMBER OF HISTORIES, OR SIMULATION TIME IN SECONDS IF VALUE < 100000
dataset.inseed                  # RANDOM SEED (ranecu PRNG), was 123456789
dataset.gpu.num_gpu             # GPU NUMBER TO USE WHEN MPI IS NOT USED, OR TO BE AVOIDED IN MPI RUNS
dataset.gpu.threads_per_block   # GPU THREADS PER CUDA BLOCK (multiple of 32), was 128
dataset.gpu.histories_per_gpu   # SIMULATED HISTORIES PER GPU THREAD, was 5000
 
#[SECTION SOURCE v.2016-12-02]
spectrum/w_rh_28.txt            # X-RAY ENERGY SPECTRUM FILE
dataset.src.xyz_cm              # SOURCE POSITION: X (chest-to-nipple), Y (right-to-left), Z (caudal-to-cranial) [cm] was 0.0 0.0 -50.0
dataset.src.uvw                 # SOURCE DIRECTION COSINES: U V W, was 0.0    0.0    1.0 
-1 -1                           # TOTAL AZIMUTHAL (WIDTH, X) AND POLAR (HEIGHT, Z) APERTURES OF THE FAN BEAM [degrees] (input negative to automatically cover the whole detector)
dataset.src.euler_deg           # EULER ANGLES (RzRyRz) TO ROTATE RECTANGULAR BEAM FROM DEFAULT POSITION AT Y=0, NORMAL=(0,-1,0) was 90.0 90.0 270.0
dataset.src.fs_fwhm_cm          # SOURCE GAUSSIAN FOCAL SPOT FWHM [cm] was 0.0000
dataset.src.ang_blur_deg        # 0.18 for DBT, 0 for FFDM [Mackenzie2017]  # ANGULAR BLUR DUE TO MOVEMENT ([exposure_time]*[angular_speed]) [degrees] was 0.0
NO				# COLLIMATE BEAM TOWARDS POSITIVE AZIMUTHAL (X) ANGLES ONLY? (ie, cone-beam center aligned with chest wall in mammography) [YES/NO]
 
#[SECTION IMAGE DETECTOR v.2017-06-20]
dataset.im.path                 # OUTPUT IMAGE FILE NAME was images/mcgpu_image
det.nu  det.nv                # NUMBER OF PIXELS IN THE IMAGE: Nx Nz was 512 512
det.pixWid_u_cm det.pixWid_v_cm  # IMAGE SIZE (width, height): Dx Dz [cm] was 60.0 60.0
spec.SSD_cm                     # SOURCE-TO-DETECTOR DISTANCE (detector set in front of the source, perpendicular to the initial direction) was 105.0
spec.im_offset_uv_cm            # IMAGE OFFSET ON DETECTOR PLANE IN WIDTH AND HEIGHT DIRECTIONS (BY DEFAULT BEAM CENTERED AT IMAGE CENTER) [cm] was 0.0 0.0
det.thickness_cm                # DETECTOR THICKNESS [cm] was 0.0250
det.MFP_cm                      # 0.004027  # ==> MFP(Se,19.0keV)  # DETECTOR MATERIAL MEAN FREE PATH AT AVERAGE ENERGY [cm] was  0.004027
det.fluor_line		        # DETECTOR K-EDGE ENERGY [eV], K-FLUORESCENCE ENERGY [eV], K-FLUORESCENCE YIELD, MFP AT FLUORESCENCE ENERGY [cm] was  12658.0 11223.0 0.596 0.00593
det.gain_evpehp det.swank       # EFFECTIVE DETECTOR GAIN, W_+- [eV/ehp], AND SWANK FACTOR (input 0 to report ideal energy fluence) was  50.0    0.99
det.e_noise_e_per_pix           # ADDITIVE ELECTRONIC NOISE LEVEL (electrons/pixel) was 5200.0 
det.cover_thickness_cm det.cover_mfp_cm  # ==> MFP(polystyrene,19keV)       # PROTECTIVE COVER THICKNESS (detector+grid) [cm], MEAN FREE PATH AT AVERAGE ENERGY [cm] was 0.10  2.65888 
det.asg.ratio det.asg.freq_pcm det.asg.leaf_thickness_cm # ANTISCATTER GRID RATIO, FREQUENCY, STRIP THICKNESS [X:1, lp/cm, cm] (enter 0 to disable the grid) was 5.0   31.0   0.0065
det.asg.leaf_MFP_cm det.asg.spacer_MFP_cm   # ==> MFP(lead&polystyrene,19keV)  # ANTISCATTER STRIPS AND INTERSPACE MEAN FREE PATHS AT AVERAGE ENERGY [cm]
det.asg.grid_parallel_to_lateral  # ORIENTATION 1D FOCUSED ANTISCATTER GRID LINES: 0==STRIPS PERPENDICULAR LATERAL DIRECTION (mammo style); 1==STRIPS PARALLEL LATERAL DIRECTION (DBT style) was 0
#[SECTION TOMOGRAPHIC TRAJECTORY v.2016-12-02]
dataset.num_proj                # ==> 1 for mammo only; ==> 25 for mammo + DBT    # NUMBER OF PROJECTIONS (1 disables the tomographic mode) was 1
dataset.src.si_cm               # SOURCE-TO-ROTATION AXIS DISTANCE was 50
dataset.dang_deg                # ANGLE BETWEEN PROJECTIONS (360/num_projections for full CT) [degrees] was  2.083333333333333333 
dataset.ang0_deg                # ANGULAR ROTATION TO FIRST PROJECTION (USEFUL FOR DBT, INPUT SOURCE DIRECTION CONSIDERED AS 0 DEGREES) [degrees] was 0.0
dataset.rot_ax_xyz              # AXIS OF ROTATION (Vx,Vy,Vz) was 1.0  0.0  0.0  
dataset.tx_per_proj_cm          # TRANSLATION ALONG ROTATION AXIS BETWEEN PROJECTIONS (HELICAL SCAN) [cm] was  0.0 
dataset.keep_det_fixed          # KEEP DETECTOR FIXED AT 0 DEGREES FOR DBT? [YES/NO] was YES 
 NO                             # SIMULATE BOTH 0 deg PROJECTION AND TOMOGRAPHIC SCAN (WITHOUT GRID) WITH 2/3 TOTAL NUM HIST IN 1st PROJ (eg, DBT+mammo)? [YES/NO]
#[SECTION DOSE DEPOSITION v.2012-12-12]
dataset.tally_material_dose     # TALLY MATERIAL DOSE? [YES/NO] (electrons not transported, x-ray energy locally deposited at interaction) was YES 
dataset.tally_3d_dose           # TALLY 3D VOXEL DOSE? [YES/NO] (dose measured separately for each voxel) was YES 
dataset.image_path             # OUTPUT VOXEL DOSE FILE NAME was images/mc-gpu_dose.dat         
dataset.voxel_dose_roi.x        # VOXEL DOSE ROI: X-index min max (first voxel has index 1) was:   1  6 
dataset.voxel_dose_roi.y         # VOXEL DOSE ROI: Y-index min max was   1  6 
dataset.voxel_dose_roi.z       # VOXEL DOSE ROI: Z-index min max   1  4 
dataset.tally_phase_space.flag   # WRITE DETECTOR-PLANE PHASE SPACE? [YES/NO] was NO
 
#[SECTION VOXELIZED GEOMETRY FILE v.2017-07-26]
dataset.voxel_geom_path   # VOXEL GEOMETRY FILE (penEasy 2008 format; .gz accepted) was phantoms/waterslabstandalone_a.vox.gz 
dataset.voxel_geom_offset_xyz  # OFFSET OF THE VOXEL GEOMETRY (DEFAULT ORIGIN AT LOWER BACK CORNER) [cm] was  -10.0    -10.0    -15.0   
 0 0 0                        # NUMBER OF VOXELS: INPUT A 0 TO READ ASCII FORMAT WITH HEADER SECTION, RAW VOXELS WILL BE READ OTHERWISE
 0.0 0.0 0.0	   	      # VOXEL SIZES [cm]
 0 0 0                        # SIZE OF LOW RESOLUTION VOXELS THAT WILL BE DESCRIBED BY A BINARY TREE, GIVEN AS POWERS OF TWO (eg, 2 2 3 = 2^2x2^2x2^3 = 128 input voxels per low res voxel; 0 0 0 disables tree)
vox_edge_path = dataset.vox_edge_path # was phantoms/waterslabstandalone_a_voxel_edges.txt
density_vox_path = dataset.vox_density_path # was phantoms/waterslabstandalone_a_density.raw.gz

